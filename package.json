{
  "name": "ai-company-simulator",
  "version": "0.2.4",
  "private": true,
  "description": "Deterministic offline company management simulator",
  "author": "Foundry contributors",
  "packageManager": "pnpm@11.19.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/build-electron.mjs",
    "build:core": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:packaged": "playwright test --config playwright.packaged.config.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "benchmark:stress": "tsx scripts/benchmark.ts --stress",
    "sim": "tsx scripts/cli.ts",
    "golden:generate": "tsx scripts/golden.ts",
    "desktop": "electron dist-electron/main.cjs",
    "package:win": "pnpm build && electron-builder --win portable --publish never",
    "build:site": "tsc --noEmit && vite build --mode hosted",
    "test:hosted": "playwright test --config playwright.hosted.config.ts",
    "benchmark:gameplay": "tsx scripts/gameplay-benchmark.ts",
    "benchmark:gameplay:long": "tsx scripts/gameplay-benchmark.ts --days=1826",
    "audit:branches": "tsx scripts/gameplay-experiments.ts",
    "audit:warnings": "tsx scripts/warning-audit.ts",
    "audit:exploits": "tsx scripts/exploit-audit.ts",
    "audit:reports": "node scripts/gameplay-report.mjs",
    "playtest": "node scripts/playthroughs.mjs",
    "benchmark:office": "tsx scripts/office-benchmark.ts",
    "audit:retention": "tsx scripts/retention-audit.ts",
    "audit:retention:controlled": "tsx scripts/retention-audit.ts --controlled --days=3652",
    "audit:retention:long": "tsx scripts/retention-audit.ts --days=3652"
  },
  "dependencies": {
    "@noble/hashes": "^2.0.1",
    "@react-three/fiber": "^9.8.1",
    "@tailwindcss/vite": "^4.1.18",
    "lucide-react": "^0.563.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.7.0",
    "sql.js": "^1.13.0",
    "tailwindcss": "^4.1.18",
    "three": "0.180.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.58.1",
    "@types/node": "^24.10.9",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@types/sql.js": "^1.4.10",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "^5.1.2",
    "electron": "^40.0.0",
    "electron-builder": "^26.7.0",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
